  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">10</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">CIC_lambda</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">162</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [lambda_ad,e] = CIC_lambda( ...
    z,phi,theta_old,P_old,Sigma0,lambda_min)

%#codegen

phi = phi(:);

% Prediction error / innovation
e = z - phi.&apos;*theta_old;

% Information term
s = phi.&apos;*P_old*phi;

% Constant Information Content forgetting factor
lambda_raw = 1 - e^2/(Sigma0*(1 + s));

% Numerical safety
lambda_ad = min(1.0,max(lambda_min,lambda_raw));

end</P>
      </eml>
    </state>
    <data SSID="4" name="z">
      <P Name="scope">INPUT_DATA</P>
