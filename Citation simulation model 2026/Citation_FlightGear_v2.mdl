<chart id="23">
  <P Name="name">Regressors Symmetr. and Asymmetr. F//M Coefficients</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">23</P>
  <P Name="ssIdHighWaterMark">17</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">build_regressors</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">23</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [phiX,phiZM,phiLat] = ...
    build_regressors(alpha,beta,p,q,r,V,de,da,dr)

% Aircraft geometry
b = 13.3250;
c = 1.9910;

% Dimensionless angular-rate terms
qhat = q*c/V;
phat = p*b/(2*V);
rhat = r*b/(2*V);

% CX
phiX = [1;
        alpha;
        alpha^2;
        qhat;
        de];

% CZ and Cm
phiZM = [1;
         alpha;
         qhat;
         de];

% CY, Cl and Cn
phiLat = [1;
          beta;
          phat;
          rhat;
          da;
          dr];

end</P>
      </eml>
    </state>
    <data SSID="6" name="alpha">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
