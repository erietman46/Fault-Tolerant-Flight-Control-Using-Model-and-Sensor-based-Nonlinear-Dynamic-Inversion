<?xml version="1.0" encoding="utf-8"?>
<chart id="40">
  <P Name="name">Calculation of Force//Moments Coefficients</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">40</P>
  <P Name="ssIdHighWaterMark">21</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">aero_measurements</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">40</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [CX,CY,CZ,Cl,Cm,Cn,rho] = ...
    aero_measurements(p,q,r,pdot,qdot,rdot,V,h,anxb,anyb,anzb)

% Aircraft constants
m   = 4500;

Ixx = 11187.8;
Iyy = 22854.8;
Izz = 31974.8;
Ixz = 1930.1;

S = 24.9900;
b = 13.3250;
c = 1.9910;

% Atmosphere
g0     = 9.80665;
R      = 287.05;
lambda = -0.0065;
T0     = 288.15;
rho0   = 1.225;
htrop  = 11000;

% Density
Ttrop = T0 + lambda*htrop;

rho_trop = rho0 * (1 + lambda*htrop/T0)^(-g0/(R*lambda)-1);

if h &lt;= htrop
    rho = rho0 * (1 + lambda*h/T0)^(-g0/(R*lambda)-1);
else
    rho = rho_trop * exp(-g0*(h-htrop)/(R*Ttrop));
end

% Convert specific forces from g to m/s^2
Ax = anxb*g0;
Ay = anyb*g0;
Az = anzb*g0;

% Dynamic pressure
qbar = 0.5*rho*V^2;

% Force coefficients
CX = m*Ax/(qbar*S);
CY = m*Ay/(qbar*S);
CZ = m*Az/(qbar*S);

% Aerodynamic moments from rigid-body rotational equations
L = Ixx*pdot + q*r*(Izz-Iyy) - (p*q + rdot)*Ixz;

M = Iyy*qdot + r*p*(Ixx-Izz) + (p^2-r^2)*Ixz;

N = Izz*rdot + p*q*(Iyy-Ixx) + (q*r-pdot)*Ixz;

% Moment coefficients
Cl = L/(qbar*S*b);
Cm = M/(qbar*S*c);
Cn = N/(qbar*S*b);

end</P>
      </eml>
    </state>
    <data SSID="4" name="p">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
